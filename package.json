{
  "name": "@matrixai/timer",
  "version": "5.0.0",
  "author": "Roger Qiu",
  "description": "Stopwatch timer object",
  "keywords": [
    "timer",
    "stopwatch",
    "setTimeout"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatrixAI/js-timer.git"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./functions": {
      "types": "./dist/functions/index.d.ts",
      "import": "./dist/functions/index.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "import": "./dist/decorators/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*": "./dist/*"
  },
  "imports": {
    "#*": "./dist/*"
  },
  "scripts": {
    "prepare": "tsc -p ./tsconfig.build.json",
    "build": "shx rm -rf ./dist && tsc -p ./tsconfig.build.json",
    "postversion": "npm install --package-lock-only --ignore-scripts --silent",
    "tsx": "tsx",
    "test": "node ./scripts/test.mjs",
    "typecheck": "tsc -p ./tsconfig.json",
    "check:candidate": "node ./scripts/check-candidate.mjs",
    "lint": "matrixai-lint --check",
    "lintfix": "matrixai-lint --fix",
    "test:browser": "npm run build && node ./tests/browser/runtime.mjs",
    "check": "npm run check:conformance && npm run lint",
    "check:portable": "node --experimental-import-meta-resolve ./scripts/check-portable.mjs",
    "check:conformance": "npm run build && npm run typecheck && npm test -- --no-file-parallelism && npm run check:portable"
  },
  "dependencies": {
    "@matrixai/async-cancellable": "git+ssh://git@github.com/MatrixAI/js-async-cancellable.git#v4.0.0",
    "@matrixai/contexts": "git+ssh://git@github.com/MatrixAI/js-contexts.git#v4.0.0",
    "@matrixai/errors": "git+ssh://git@github.com/MatrixAI/js-errors.git#v3.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "shx": "^0.3.4",
    "tsx": "^4.19.3",
    "typescript": "~5.9.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "!dist/tsbuildinfo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
